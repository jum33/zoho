# ---- Zoho CRM (OAuth 2, datacenter EU par défaut) ----
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Datacenter : eu (accounts.zoho.eu / www.zohoapis.eu), com, in, au, jp, ca, sa
ZOHO_DC=eu
# Version de l'API REST Zoho CRM
ZOHO_API_VERSION=v6

# ---- Serveur MCP ----
# Clé statique attendue en "Authorization: Bearer <clé>" ou "X-API-Key: <clé>".
# Générer par ex. : openssl rand -hex 32
MCP_API_KEY=change-me
PORT=3000
# true => seuls les outils de lecture sont exposés (aucune écriture possible)
ZOHO_READ_ONLY=false
# true => expose l'outil zoho_delete_records (désactivé par défaut)
ZOHO_ALLOW_DELETE=false
